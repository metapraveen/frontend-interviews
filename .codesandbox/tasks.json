{
  "setupTasks": [
    {
      "name": "Install dependencies",
      "command": "npm install"
    }
  ],
  "tasks": {
    "dev": {
      "name": "Vite dev server",
      "command": "npm run dev",
      "runAtStart": true,
      "preview": {
        "port": 3000
      }
    },
    "storybook": {
      "name": "Storybook",
      "command": "npm run storybook",
      "runAtStart": false,
      "preview": {
        "port": 9001
      }
    },
    "test": {
      "name": "Tests",
      "command": "npm run test:run"
    }
  }
}
