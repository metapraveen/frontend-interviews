{
  "setupTasks": [
    {
      "name": "Install dependencies",
      "command": "npm install"
    }
  ],
  "tasks": {
    "start": {
      "name": "CRA dev server",
      "command": "BROWSER=none HOST=0.0.0.0 WDS_SOCKET_PORT=443 npm start",
      "runAtStart": true,
      "preview": {
        "port": 3000
      }
    },
    "storybook": {
      "name": "Storybook",
      "command": "npm run storybook",
      "runAtStart": false,
      "preview": {
        "port": 9001
      }
    },
    "test": {
      "name": "Tests",
      "command": "npm test -- --watchAll=false"
    }
  }
}
